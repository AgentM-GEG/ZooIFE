################################################################################
# ZOONIVERSE API CONFIGURATION
################################################################################

# Panoptes API endpoints
# Production Panoptes (default)
VITE_PANOPTES_API_BASE=https://www.zooniverse.org/api
# Staging Panoptes (for testing)
VITE_PANOPTES_STAGING_BASE=https://panoptes-staging.zooniverse.org/api

# Caesar API endpoints (GraphQL)
# Production Caesar (default)
VITE_CAESAR_API_BASE=https://caesar.zooniverse.org/graphql
# Staging Caesar (for testing)
VITE_CAESAR_STAGING_BASE=https://caesar-staging.zooniverse.org/graphql

# Toggle between production and staging APIs
# Set to 'true' to use staging endpoints, 'false' (default) for production
VITE_ZOONIVERSE_USE_STAGING_APIS=false

# Zooniverse project and workflow IDs
# Project ID is optional; workflow is required for subject queue
# Workflow ID example: 29070, 31349
VITE_ZOONIVERSE_PROJECT_ID=
VITE_ZOONIVERSE_WORKFLOW_ID=29070

# Subject set ID (optional, required only for grouped workflows)
# VITE_ZOONIVERSE_SUBJECT_SET_ID=


################################################################################
# OAUTH AUTHENTICATION
################################################################################

# Zooniverse OAuth application credentials
# Obtain from: https://panoptes.zooniverse.org/oauth/applications
VITE_REACT_APP_CLIENT_ID=your-oauth-client-id-here

# OAuth redirect URI
# Must match the URI registered in your Zooniverse OAuth application
# Default: http://localhost:5173/auth/callback (for local development)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Local OAuth server base URL
# Points to the Python OAuth proxy server (runs on port 8080)
# Default: http://localhost:8080
VITE_OAUTH_SERVER_BASE=http://localhost:8080


################################################################################
# CAESAR ML CONFIGURATION
################################################################################

# Default tool type for Caesar annotations
# Options: "rectangle" | "default"
# Use "rectangle" if Caesar returns rectangle-type annotations
# Default: "default"
VITE_CAESAR_DEFAULT_TOOL_TYPE=default


################################################################################
# DEBUGGING and DEVELOPMENT
################################################################################

# Enable debug logging in browser console
# Comma-separated namespace patterns, supports wildcards:
#   'app:*'           - All app namespaces
#   'app:store'       - Only store logs
#   'app:canvas'      - Only canvas logs
#   'app:sam2'        - Only SAM2 logs
#   'app:auth'        - Only auth logs
#   'app:history'     - Only history logs
# Examples:
#   VITE_DEBUG_LOGS=app:*              # All logs
#   VITE_DEBUG_LOGS=app:store,app:auth # Store and auth logs
#   VITE_DEBUG_LOGS=                   # Disable (empty string or unset)
VITE_DEBUG_LOGS=

# Show debug UI tools in the application
# Options: 'true' | 'false' | '1' | '0'
# When enabled, shows Debug Options panel with:
#   - Zoom controls
#   - Coordinate system fixes
#   - Mask overlay toggles
#   - Debug image display
VITE_SHOW_DEBUG_UI=false


################################################################################
# TESTING - Integration Tests (Optional)
################################################################################

# Real Zooniverse refresh token for integration testing
# Only set if you want to run integration tests against real Zooniverse OAuth
# 
# Do NOT commit this to version control!
# 
# To obtain a test token:
# 1. Log in to the app in your browser
# 2. Open DevTools → Application → Local Storage → zoo_tokens
# 3. Copy the 'refresh_token' value
# 
# To run integration tests:
#   export VITE_ZOONIVERSE_TEST_REFRESH_TOKEN="your-token-here"
#   npm run test -- integration
# 
# Or use a .env.local file (git-ignored):
#   VITE_ZOONIVERSE_TEST_REFRESH_TOKEN=your-token-here
#   npm run test
# 
# If not set, integration tests are skipped (unit tests still run).
# Unit tests (mocked) are recommended for regular testing.
# VITE_ZOONIVERSE_TEST_REFRESH_TOKEN=
